# Copy to .env and fill in ONE provider. .env is git-ignored.

# --- Option A (default): Claude via the Anthropic API ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5     # default; any Claude model id works

# --- Option B: Browser Use's own BU2 model (fast, browser-tuned) ---
# LLM_PROVIDER=browser-use
# BROWSER_USE_API_KEY=              # https://cloud.browser-use.com/new-api-key
# BROWSER_USE_MODEL=bu-2-0

# browser-use sends anonymous usage telemetry unless you opt out.
ANONYMIZED_TELEMETRY=false
